# =============================================================================
# Harvester — Recursive Crawling Queue Builder
# =============================================================================

# --- Application ---
APP_NAME=Harvester
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://harvester:harvester@localhost:5432/harvester
POSTGRES_USER=harvester
POSTGRES_PASSWORD=harvester
POSTGRES_DB=harvester

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Crawlberg API Server (the queue) ---
# Start with: crawlberg serve --host 0.0.0.0 --port 3000
CRAWLBERG_API_URL=http://localhost:3000
CRAWLBERG_API_KEY=
CRAWLBERG_POLL_INTERVAL=5
CRAWLBERG_POLL_MAX_ATTEMPTS=720

# --- S3 / MinIO (Local Development) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=harvester-documents
S3_REGION=us-east-1
S3_SECURE=false

# --- Cloudflare R2 (Production) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Webshare Proxy ---
# https://apidocs.webshare.io/ — free tier: 10 proxies
WEBSHARE_USE_PROXY=false
WEBSHARE_API_KEY=
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
WEBSHARE_PROXY_HOST=p.webshare.io
WEBSHARE_PROXY_PORT=80

# --- OCR (Docling) ---
OCR_LANGUAGES=eng

# --- Transform (parquet-converter Go tool) ---
# https://github.com/iwillwen/parquet-converter
USE_PARQUET_CONVERTER=true
PARQUET_CONVERTER_PATH=/usr/local/bin/parquet-converter

# --- Pipeline Defaults ---
DEFAULT_JOB_RUN_ID=10
MAX_DEPTH=3
MAX_PAGES=1000
MAX_FILE_SIZE=104857600

# --- Temp ---
TEMP_DIR=/tmp/harvester

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
