# =============================================================================
# Harvester Configuration
# =============================================================================

# --- Application ---
APP_NAME=Harvester
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://harvester:harvester@localhost:5432/harvester
POSTGRES_USER=harvester
POSTGRES_PASSWORD=harvester
POSTGRES_DB=harvester

# --- Redis (Celery broker) ---
REDIS_URL=redis://localhost:6379/0

# --- Crawlberg API Server ---
# Start with: crawlberg serve --host 0.0.0.0 --port 3000
# Or via Docker: docker run -p 3000:3000 ghcr.io/xberg-io/crawlberg:latest serve
CRAWLBERG_API_URL=http://localhost:3000
CRAWLBERG_API_KEY=

# --- S3 / MinIO (Local Development) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=harvester-documents
S3_REGION=us-east-1
S3_SECURE=false

# --- Cloudflare R2 (Production) ---
# Leave empty to use MinIO instead
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# --- Webshare Proxy ---
# Sign up at https://www.webshare.io/ (free tier: 10 proxies)
WEBSHARE_USE_PROXY=false
WEBSHARE_API_KEY=
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
WEBSHARE_PROXY_HOST=p.webshare.io
WEBSHARE_PROXY_PORT=80

# --- Embeddings (Local) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CHUNK_SIZE=512
EMBEDDING_CHUNK_OVERLAP=50

# --- OCR (Docling) ---
OCR_LANGUAGES=eng
OCR_DPI=300

# --- Crawler Settings ---
CRAWLER_USER_AGENT=Harvester/1.0 (+https://github.com/labsbytir/Gatherer)
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_PAGES=1000
CRAWLER_CONCURRENT_REQUESTS=4
CRAWLER_DOWNLOAD_TIMEOUT=60
CRAWLER_MAX_FILE_SIZE=104857600
CRAWLER_RESPECT_ROBOTS=true

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false

# --- Celery ---
CELERY_CONCURRENCY=2
CELERY_LOG_LEVEL=INFO

# --- Pipeline ---
TEMP_DIR=/tmp/harvester
JOB_POLL_INTERVAL=5
JOB_POLL_MAX_ATTEMPTS=720
